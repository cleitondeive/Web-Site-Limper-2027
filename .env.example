# PostgreSQL connection string (in Easypanel on Hostinger VPS, use the internal service URL)
# Example: postgres://postgres:STRONG_PASSWORD@limper-db:5432/limpermt
DATABASE_URL=

# Set to "true" if your PostgreSQL provider requires TLS/SSL (leave "false" for internal Easypanel Docker network)
DATABASE_SSL=false

# Master admin password for the Limper MT admin panel (overrides first-run setup when set)
ADMIN_MASTER_PASSWORD=

# Production public domain URL
APP_URL=https://limpermt.com.br

# Server port (must stay 3000 for Easypanel and preview)
PORT=3000

# Optional: Gemini API key if AI features are enabled
GEMINI_API_KEY=

